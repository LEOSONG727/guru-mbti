# GURU-MBTI Supabase Configuration Example
# Copy this file to '.env' and fill in your Supabase project credentials.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Link to other services (optional)
VITE_MIND_DOT_URL=https://mind-dot.vercel.app

# Scraper service_role Key (Secret Key, NOT exposed to client. Used for DB sync)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
